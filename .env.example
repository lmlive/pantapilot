# ===== PantaPilot 环境变量 =====
# 复制为 .env 后填写。chmod 600 .env，.env 已在 gitignore 中。

# --- 安全护栏 ---
# DRY_RUN=true（默认）只走到询价+构建未签名交易即停，绝不签名广播。
DRY_RUN=true
# 单笔交易 USDC 上限（评审要求"单笔不超几 USDC"）
MAX_TRADE_USDC=5
# 扫描间隔（分钟）
SCAN_INTERVAL_MINUTES=3

# --- Panta API ---
PANTA_BASE_URL=https://live-api.panta.market/api/v1
# 必须是 env:"live" 生成的 key（pk_test_ 只能看到沙盒假数据）
PANTA_API_KEY=pk_live_xxxxxxxxxxxxxxxx

# --- 钱包（专用小额 keypair，绝不用主钱包）---
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
# 仅真机广播需要（DRY_RUN=false）
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- LLM（OpenAI 兼容接口，OpenRouter）---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=cohere/north-mini-code:free
# 免费模型可能抽风，超时 60s + 重试 1 次
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# 触发下单的最小置信度
MIN_CONFIDENCE=0.6

# --- 多角色 Agent 团队 ---
# true = Scout→Estimator→Decision→Risk 流水线；false = 单 agent 静态分析
AGENTS_ENABLED=true
# Scout 无 oracle 官方源时是否用 Brave Search 兜底搜集情报
SCOUT_SEARCH_ENABLED=true