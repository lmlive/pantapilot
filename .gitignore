# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 密钥与环境
.env
.env.local
# Backups and variants of .env hold live keys too. The bare `.env` rule does NOT
# cover them - a `.env.bak-<ts>` got committed once and GitHub's push protection
# caught the OpenRouter key. Keep this glob.
.env.*
!.env.example

# 运行产物
logs/
dashboard/index.html

# 视频/看板构建中间产物（仅保留 docs/ 下的成品与 demo_capture 的录制证据）
demo_capture/video/
demo_capture/run_raw.txt
demo_capture/_dashboard_norefresh.html

# 其它
.DS_Store
*.log